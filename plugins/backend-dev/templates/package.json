{
  "name": "my-api",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:stag": "wrangler deploy --env stag",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "dependencies": {
    "effect": "3.22.3",
    "hono": "4.13.13",
    "hono-openapi": "1.5.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.151.3"
  }
}
